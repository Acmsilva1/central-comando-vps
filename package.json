{
  "name": "central-comando-vps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "demo": "node src/server.mjs --demo",
    "check": "node scripts/check.mjs",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs",
    "pwa:version": "node scripts/sync-pwa-version.mjs"
  }
}
